{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json"
  ],
  "exclude": [
    "src/animations",
    "src/components/ActHeading.tsx",
    "src/components/Avatar.tsx",
    "src/components/HorizonPlate.tsx",
    "src/components/Intro.tsx",
    "src/components/IntroContext.ts",
    "src/components/Nav.tsx",
    "src/components/ProjectCover.tsx",
    "src/components/ui",
    "src/data/world.ts",
    "src/lib/journey.ts",
    "src/pages/ProjectPage.tsx",
    "src/sections/Archive.tsx",
    "src/sections/Journey.tsx",
    "src/sections/Moments.tsx",
    "src/sections/Philosophy.tsx",
    "src/sections/Tools.tsx"
  ]
}